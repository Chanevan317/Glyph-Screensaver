ARG BASE
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends gnome-shell gnome-shell-extension-prefs \
      libgl1-mesa-dri libegl1 dbus dbus-user-session dconf-service dconf-gsettings-backend python3 python3-venv \
      libglib2.0-bin fonts-dejavu-core procps ca-certificates zip unzip >/dev/null && rm -rf /var/lib/apt/lists/*
